<launch>
    <!-- ==================== LEFT ARM (灵巧手, 192.168.1.19, port 8010) ==================== -->
    <group ns="left_arm">
        <param name="robot_description" textfile="$(find rm_description)/urdf/left_arm.urdf" />
        <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
            <remap from="joint_states" to="/joint_states" />
        </node>
    </group>

    <!-- Left arm hardware nodes (outside namespace to keep original topic names) -->
    <node pkg="rm_65_pkg" type="arm_75_bringup.py" name="arm_75_bringup" output="screen" />
    <node pkg="rm_65_pkg" type="mount_camera.py" name="mount_camera_erdaiji_grasp_left" output="screen" />
    <!-- Left arm gripper is driven by dependence/gripper-programming/server.py on :8002
         (started by start.bash), no ROS node needed. The old inspire_hand_bringup
         node for the dexterous hand has been removed. -->

    <!-- ==================== RIGHT ARM (夹爪, 192.168.1.18, port 8011) ==================== -->
    <group ns="right_arm">
        <param name="robot_description" textfile="$(find rm_description)/urdf/right_arm.urdf" />
        <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
            <remap from="joint_states" to="/right_joint_states" />
        </node>
    </group>

    <!-- Right arm hardware nodes -->
    <node pkg="rm_65_pkg" type="arm_75_bringup_right.py" name="arm_75_bringup_right" output="screen" />
    <node pkg="rm_65_pkg" type="mount_camera_right.py" name="mount_camera_erdaiji_grasp_right" output="screen" />

    <!-- ==================== COMBINED DUAL-ARM VIZ (replaces separate left/right RViz) ==================== -->
    <param name="robot_description" textfile="$(find rm_description)/urdf/dual_arm.urdf" />

    <node name="joint_state_relay" pkg="rm_description" type="joint_state_relay.py" output="screen">
        <param name="rate" value="30.0" />
    </node>

    <node name="robot_state_publisher_dual" pkg="robot_state_publisher" type="robot_state_publisher">
        <remap from="joint_states" to="dual_joint_states" />
    </node>

    <node name="rviz_dual" pkg="rviz" type="rviz" args="-d $(find rm_description)/config/dual_arm.rviz" />
</launch>
