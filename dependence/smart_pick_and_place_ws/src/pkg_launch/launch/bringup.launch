<launch>
    <!-- ==================== LEFT ARM (灵巧手, 192.168.1.19, port 8010) ==================== -->
    <group ns="left_arm">
        <param name="robot_description" textfile="$(find rm_description)/urdf/LeftArm/left_arm.urdf" />
        <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
            <remap from="joint_states" to="/joint_states" />
        </node>
        <!-- Left arm RViz -->
        <node name="rviz_left" pkg="rviz" type="rviz" args="-d $(find rm_description)/config/left_arm.rviz" />
    </group>

    <!-- Left arm hardware nodes (outside namespace to keep original topic names) -->
    <node pkg="rm_65_pkg" type="arm_75_bringup.py" name="arm_75_bringup" output="screen" />
    <node pkg="rm_65_pkg" type="mount_camera.py" name="mount_camera_erdaiji_grasp_left" output="screen" />
    <node pkg="rm_65_pkg" type="inspire_hand_bringup.py" name="inspire_hand_bringup" output="screen" />

    <!-- ==================== RIGHT ARM (夹爪, 192.168.1.18, port 8011) ==================== -->
    <group ns="right_arm">
        <param name="robot_description" textfile="$(find rm_description)/urdf/LeftArm/right_arm.urdf" />
        <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
            <remap from="joint_states" to="/right_joint_states" />
        </node>
        <!-- Right arm RViz -->
        <node name="rviz_right" pkg="rviz" type="rviz" args="-d $(find rm_description)/config/right_arm.rviz" />
    </group>

    <!-- Right arm hardware nodes -->
    <node pkg="rm_65_pkg" type="arm_75_bringup_right.py" name="arm_75_bringup_right" output="screen" />
    <node pkg="rm_65_pkg" type="mount_camera_right.py" name="mount_camera_erdaiji_grasp_right" output="screen" />
</launch>
